---
import { getCollection } from 'astro:content';
import MainLayout from '@layouts/MainLayout.astro';
import PageHeader from '@components/directory/PageHeader.astro';
import FilterBar from '@components/directory/FilterBar.astro';
import { directoryCopy } from '@copy/directory';
import type { MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}
const { locale } = Astro.props;
const t = directoryCopy[locale];
const resources = (
  await getCollection(
    'resources',
    ({ data }) => data.reviewStatus === 'published'
  )
).sort((a, b) => a.data.title[locale].localeCompare(b.data.title[locale]));
const options = (values: string[], labels: Record<string, string>) =>
  [...new Set(values)]
    .sort()
    .map(value => ({ value, label: labels[value] ?? value }));
const filters = [
  {
    key: 'category',
    label: t.resources.category,
    options: options(
      resources.map(item => item.data.category),
      t.resources.categories
    ),
  },
  {
    key: 'provider',
    label: t.resources.provider,
    options: options(
      resources.map(item => item.data.providerType),
      t.common
    ),
  },
  {
    key: 'language',
    label: t.resources.language,
    options: options(
      resources.flatMap(item => item.data.languages),
      { en: 'English', 'zh-cn': '简体中文' }
    ),
  },
  {
    key: 'audience',
    label: t.resources.audience,
    options: options(
      resources.flatMap(item => item.data.audience),
      t.resources.audiences
    ),
  },
];
---

<MainLayout
  title={t.resources.metaTitle}
  description={t.resources.metaDescription}
  section={t.resources.title}
>
  <div class="mx-auto max-w-6xl py-12 sm:py-16">
    <PageHeader
      eyebrow={t.resources.eyebrow}
      title={t.resources.title}
      intro={t.resources.intro}
    />
    <div class="mt-10">
      <FilterBar
        queryLabel={t.resources.query}
        queryPlaceholder={t.resources.placeholder}
        filters={filters}
        allLabel={t.common.all}
        resetLabel={t.common.reset}
        showingTemplate={t.resources.showing}
        emptyMessage={t.resources.empty}
        noScriptMessage={t.common.noScript}
      >
        <div class="grid gap-6 md:grid-cols-2">
          {resources.map(({ data }) => (
            <article
              data-filter-item
              data-search={`${data.title.en} ${data.title['zh-cn']} ${data.purpose.en} ${data.purpose['zh-cn']} ${data.tags.join(' ')}`}
              data-category={data.category}
              data-provider={data.providerType}
              data-language={data.languages.join(' ')}
              data-audience={data.audience.join(' ')}
              class="flex flex-col rounded-2xl border border-neutral-300 bg-neutral-50 p-6 dark:border-neutral-700 dark:bg-neutral-900/60"
            >
              <div class="flex flex-wrap gap-2 text-xs font-semibold text-amber-700 dark:text-amber-300">
                <span>{t.resources.categories[data.category]}</span>
                <span>·</span>
                <span>{t.common[data.providerType]}</span>
              </div>
              <h2 class="mt-3 text-xl font-bold">{data.title[locale]}</h2>
              <p class="mt-1 text-xs text-neutral-500">
                {data.provider} ·{' '}
                {data.languages
                  .map(lang => (lang === 'en' ? 'English' : '简体中文'))
                  .join(' / ')}
              </p>
              <p class="mt-5 text-sm leading-6 text-neutral-700 dark:text-neutral-300">
                <strong>{t.resources.purpose}:</strong> {data.purpose[locale]}
              </p>
              <p class="mt-3 grow text-sm leading-6 text-neutral-600 dark:text-neutral-400">
                {data.editorialNote[locale]}
              </p>
              <p class="mt-5 text-xs leading-5 text-neutral-500">
                {t.resources.verified} · {t.common.checked}:{' '}
                {data.verification.lastChecked}
              </p>
              <a
                href={data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-block text-sm font-bold text-amber-700 hover:underline dark:text-amber-300"
              >
                {t.resources.visit} ↗
                <span class="sr-only"> ({t.common.external})</span>
              </a>
            </article>
          ))}
        </div>
      </FilterBar>
    </div>
  </div>
</MainLayout>
