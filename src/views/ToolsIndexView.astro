---
import MainLayout from '@layouts/MainLayout.astro';
import { toolsCopy } from '@copy/tools';
import { localePath, type MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}
const { locale } = Astro.props;
const t = toolsCopy[locale].index;
const tools = [
  {
    number: '01',
    path: '/tools/crop-factor/',
    title: t.cropTitle,
    description: t.cropDescription,
    formula: 'fₑq = f × c',
  },
  {
    number: '02',
    path: '/tools/exposure-stops/',
    title: t.exposureTitle,
    description: t.exposureDescription,
    formula: 'Δ stops = log₂(ratio)',
  },
];
---

<MainLayout
  title={t.metaTitle}
  description={t.metaDescription}
  section={t.title}
>
  <div class="mx-auto max-w-7xl py-12 sm:py-16">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-amber-700 uppercase dark:text-amber-300">
        {t.eyebrow}
      </p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-neutral-900 sm:text-5xl dark:text-neutral-100">
        {t.title}
      </h1>
      <p class="mt-5 text-base leading-7 text-neutral-600 sm:text-lg dark:text-neutral-400">
        {t.intro}
      </p>
    </header>
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {tools.map(tool => (
        <a
          href={localePath(locale, tool.path)}
          class="group flex min-w-0 flex-col rounded-3xl border border-neutral-300 bg-neutral-50 p-6 transition-colors hover:border-amber-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-500 sm:p-8 dark:border-neutral-700 dark:bg-neutral-900/60"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="text-sm font-bold text-amber-700 dark:text-amber-300">
              {tool.number}
            </span>
            <span class="text-xs font-medium tracking-wide text-neutral-500 uppercase dark:text-neutral-400">
              {t.formula}
            </span>
          </div>
          <code class="mt-8 text-lg text-neutral-700 dark:text-neutral-300">
            {tool.formula}
          </code>
          <h2 class="mt-4 text-2xl font-bold text-neutral-900 group-hover:text-amber-700 dark:text-neutral-100 dark:group-hover:text-amber-300">
            {tool.title}
          </h2>
          <p class="mt-3 grow text-sm leading-6 text-neutral-600 dark:text-neutral-400">
            {tool.description}
          </p>
          <span class="mt-8 text-sm font-bold text-neutral-900 dark:text-neutral-100">
            {t.open}{' '}
            <span aria-hidden="true" class="inline-block">
              →
            </span>
          </span>
        </a>
      ))}
    </div>
  </div>
</MainLayout>
