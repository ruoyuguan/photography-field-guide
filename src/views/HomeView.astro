---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';
import { directoryCopy } from '@copy/directory';
import { toolsCopy } from '@copy/tools';
import { practiceCopy } from '@data/practice';
import LearningStarts from '@components/learn/LearningStarts.astro';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).home;
const labels = getCopy(locale).nav.labels;
const directory = directoryCopy[locale];
const destinations = [
  {
    path: '/practice/',
    title: labels.practice,
    description: practiceCopy[locale].intro,
  },
  {
    path: '/tools/',
    title: labels.tools,
    description: toolsCopy[locale].index.intro,
  },
  {
    path: '/glossary/',
    title: labels.glossary,
    description: directory.glossary.intro,
  },
  { path: '/gear/', title: labels.gear, description: directory.gear.intro },
  {
    path: '/galleries/',
    title: labels.galleries,
    description: directory.galleries.intro,
  },
  {
    path: '/resources/',
    title: labels.resources,
    description: directory.resources.intro,
  },
  { path: '/about/', title: labels.about, description: directory.about.intro },
];
---

<MainLayout>
  <section class="relative isolate mt-8 overflow-hidden rounded-[2rem] border border-neutral-300/80 bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900">
    <div class="absolute -right-24 -top-24 -z-10 h-80 w-80 rounded-full bg-amber-300/25 blur-3xl dark:bg-amber-500/10"></div>
    <div class="grid items-center gap-12 px-6 py-14 sm:px-10 lg:grid-cols-[1.05fr_0.95fr] lg:px-16 lg:py-20">
      <div class="order-1">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.2em] text-amber-700 dark:text-amber-300">
          {copy.eyebrow}
        </p>
        <h1 class="max-w-2xl text-balance text-4xl font-extrabold leading-[1.08] tracking-tight text-neutral-900 sm:text-5xl lg:text-6xl dark:text-neutral-50">
          <Fragment set:html={copy.hero.title} />
        </h1>
        <p class="mt-6 max-w-xl text-pretty text-lg leading-8 text-neutral-600 dark:text-neutral-300">
          {copy.hero.subTitle}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={localePath(locale, '/learn/')}
            class="rounded-full bg-neutral-900 px-6 py-3 text-sm font-bold text-white transition hover:bg-amber-500 hover:text-neutral-950 dark:bg-amber-400 dark:text-neutral-950 dark:hover:bg-amber-300"
          >
            {copy.hero.primaryBtn}
          </a>
          <a
            href={localePath(locale, '/practice/')}
            class="rounded-full border border-neutral-400 px-6 py-3 text-sm font-bold text-neutral-800 transition hover:border-amber-500 hover:text-amber-700 dark:border-neutral-600 dark:text-neutral-100 dark:hover:text-amber-300"
          >
            {labels.practice}
          </a>
        </div>
      </div>

      <div class="order-2 lg:order-3 lg:col-span-2">
        <LearningStarts locale={locale} />
      </div>

      <figure class="order-3 lg:order-2 rounded-3xl border border-neutral-300 bg-white p-5 shadow-xl shadow-neutral-900/5 sm:p-7 dark:border-neutral-700 dark:bg-neutral-950">
        <div class="mb-5 flex items-start justify-between gap-4">
          <div>
            <h2 class="font-bold text-neutral-900 dark:text-neutral-100">
              {copy.sensor.title}
            </h2>
            <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
              {copy.sensor.caption}
            </p>
          </div>
          <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800 dark:bg-amber-400/10 dark:text-amber-300">
            3:2
          </span>
        </div>
        <svg
          viewBox="0 0 560 360"
          class="h-auto w-full"
          role="img"
          aria-label={copy.sensor.caption}
          data-sensor-diagram="36x24:23.5x15.7"
        >
          <title>{copy.sensor.caption}</title>
          <rect x="60" y="35" width="440" height="290" rx="14" fill="#171717" />
          <rect
            data-sensor="full-frame"
            x="100"
            y="60"
            width="360"
            height="240"
            rx="2"
            fill="#fbbf24"
            fill-opacity="0.13"
            stroke="#fbbf24"
            stroke-width="2"
          />
          <rect
            data-sensor="aps-c"
            x="162.5"
            y="101.5"
            width="235"
            height="157"
            rx="2"
            fill="#38bdf8"
            fill-opacity="0.12"
            stroke="#38bdf8"
            stroke-width="2"
            stroke-dasharray="8 7"
          />
          <path d="M280 50v260M90 180h380" stroke="#525252" stroke-width="1" />
          <text x="108" y="86" fill="#fbbf24" font-size="16" font-weight="700">
            {copy.sensor.fullFrame}
          </text>
          <text x="170" y="128" fill="#38bdf8" font-size="15" font-weight="700">
            {copy.sensor.apsc}
          </text>
        </svg>
        <div class="mt-3 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-xl bg-amber-50 p-3 dark:bg-amber-400/10">
            <span class="block font-bold text-amber-800 dark:text-amber-300">
              {copy.sensor.fullFrame}
            </span>
            <span class="text-neutral-600 dark:text-neutral-300">
              {copy.sensor.fullFrameSize}
            </span>
          </div>
          <div class="rounded-xl bg-sky-50 p-3 dark:bg-sky-400/10">
            <span class="block font-bold text-sky-800 dark:text-sky-300">
              {copy.sensor.apsc}
            </span>
            <span class="text-neutral-600 dark:text-neutral-300">
              {copy.sensor.apscSize}
            </span>
          </div>
        </div>
        <figcaption class="mt-4 text-xs leading-5 text-neutral-500 dark:text-neutral-400">
          {copy.sensor.note}
        </figcaption>
      </figure>
    </div>
  </section>

  <section
    class="mx-auto max-w-6xl px-2 py-16 sm:px-6"
    aria-label={labels.resources}
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {destinations.map(item => (
        <a
          href={localePath(locale, item.path)}
          class="group rounded-2xl border border-neutral-300 bg-neutral-50 p-6 transition hover:border-amber-500 dark:border-neutral-700 dark:bg-neutral-900/60"
        >
          <h2 class="text-xl font-bold text-neutral-900 group-hover:text-amber-700 dark:text-neutral-100 dark:group-hover:text-amber-300">
            {item.title}
          </h2>
          <p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-400">
            {item.description}
          </p>
          <span
            class="mt-5 inline-block text-sm font-bold text-amber-700 dark:text-amber-300"
            aria-hidden="true"
          >
            →
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto mb-4 max-w-6xl px-2 sm:px-6">
    <div class="rounded-[2rem] bg-neutral-900 px-6 py-10 text-center sm:px-10 dark:bg-neutral-950">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">
        {copy.cta.title}
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-neutral-300">{copy.cta.subTitle}</p>
      <a
        href={localePath(locale, '/learn/')}
        class="mt-6 inline-block rounded-full bg-amber-400 px-6 py-3 text-sm font-bold text-neutral-950 transition hover:bg-amber-300"
      >
        {copy.cta.button}
      </a>
    </div>
  </section>
</MainLayout>
