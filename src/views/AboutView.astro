---
import MainLayout from '@layouts/MainLayout.astro';
import PageHeader from '@components/directory/PageHeader.astro';
import { directoryCopy } from '@copy/directory';
import { localePath, type MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}
const { locale } = Astro.props;
const t = directoryCopy[locale].about;
const common = directoryCopy[locale].common;
const sections = [
  [t.goalTitle, t.goalBody],
  [t.qualityTitle, t.qualityBody],
  [t.sourcesTitle, t.sourcesBody],
  [t.contributeTitle, t.contributeBody],
];
---

<MainLayout
  title={t.metaTitle}
  description={t.metaDescription}
  section={t.title}
>
  <div class="mx-auto max-w-4xl py-12 sm:py-16">
    <PageHeader eyebrow={t.eyebrow} title={t.title} intro={t.intro} />
    <div class="mt-12 space-y-6">
      {sections.map(([title, body]) => (
        <section class="rounded-2xl border border-neutral-300 bg-neutral-50 p-7 dark:border-neutral-700 dark:bg-neutral-900/60">
          <h2 class="text-2xl font-bold">{title}</h2>
          <p class="mt-4 leading-8 text-neutral-700 dark:text-neutral-300">
            {body}
          </p>
        </section>
      ))}
    </div>
    <a
      href="https://github.com/ruoyuguan/photography-field-guide"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-block font-bold text-amber-700 hover:underline dark:text-amber-300"
    >
      {t.repository} ↗<span class="sr-only"> ({common.external})</span>
    </a>
    <section class="mt-10 rounded-2xl bg-neutral-100 p-7 dark:bg-neutral-900">
      <h2 class="text-2xl font-bold">{t.copyrightTitle}</h2>
      <p class="mt-4 leading-8 text-neutral-700 dark:text-neutral-300">
        {t.copyrightBody}
      </p>
      <a
        href="https://github.com/ruoyuguan/photography-field-guide/blob/main/LICENSE"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-block text-sm font-bold text-amber-700 hover:underline dark:text-amber-300"
      >
        {t.license} ↗
      </a>
    </section>
    <nav aria-label={t.title} class="mt-10 flex flex-wrap gap-3">
      {[
        ['/learn/', 'Learn'],
        ['/glossary/', 'Glossary'],
        ['/resources/', 'Resources'],
      ].map(([path, label]) => (
        <a
          href={localePath(locale, path)}
          class="rounded-full border border-neutral-400 px-4 py-2 text-sm font-semibold dark:border-neutral-600"
        >
          {label} →
        </a>
      ))}
    </nav>
  </div>
</MainLayout>
