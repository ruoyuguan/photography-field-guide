---
import MainLayout from '@layouts/MainLayout.astro';
import PracticeMission from '@components/practice/PracticeMission.astro';
import { missionById, type PracticeLocale } from '@data/practice';

interface Props {
  locale: PracticeLocale;
  missionId: string;
}
const { locale, missionId } = Astro.props;
const mission = missionById(missionId);
if (!mission) throw new Error(`Unknown practice mission: ${missionId}`);
const t = mission.copy[locale];
---

<MainLayout
  title={t.metaTitle}
  description={t.metaDescription}
  section="Practice"
>
  <PracticeMission locale={locale} mission={mission} />
</MainLayout>
