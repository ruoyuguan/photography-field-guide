---
import { filmProcessCopy } from '@copy/film-process';
import type { MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = filmProcessCopy[locale];
---

<section
  aria-labelledby="film-process-examples"
  class="mt-8 border-t border-neutral-300 pt-7 dark:border-neutral-700"
>
  <h2
    id="film-process-examples"
    tabindex="-1"
    class="scroll-mt-28 text-2xl font-bold"
  >
    {t.title}
  </h2>
  <p class="mt-3 max-w-3xl leading-7 text-neutral-700 dark:text-neutral-300">
    {t.intro}
  </p>
  <div class="mt-5 rounded-xl border border-neutral-300 bg-white dark:border-neutral-600 dark:bg-neutral-950">
    <table
      aria-labelledby="film-process-examples"
      class="w-full table-fixed text-start text-sm leading-5 [overflow-wrap:anywhere] sm:leading-6"
    >
      <thead class="border-b border-neutral-300 dark:border-neutral-600">
        <tr>
          <th scope="col" class="w-[36%] px-2 py-2 text-start sm:px-4 sm:py-3">
            {t.columns[0]}
          </th>
          <th scope="col" class="w-[25%] px-2 py-2 text-start sm:px-4 sm:py-3">
            {t.columns[1]}
          </th>
          <th scope="col" class="px-2 py-2 text-start sm:px-4 sm:py-3">
            {t.columns[2]}
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-200 dark:divide-neutral-700">
        {t.examples.map(example => (
          <tr data-film-process-example={example.id} class="align-top">
            <th
              scope="row"
              class="px-2 py-2 text-start font-semibold sm:px-4 sm:py-3"
            >
              {example.name}
            </th>
            <td class="px-2 py-2 text-neutral-700 sm:px-4 sm:py-3 dark:text-neutral-300">
              {example.process}
            </td>
            <td class="px-2 py-2 text-neutral-700 sm:px-4 sm:py-3 dark:text-neutral-300">
              {example.result}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <details
    data-film-process-self-check
    class="mt-5 rounded-xl border border-neutral-300 bg-neutral-100 p-4 dark:border-neutral-600 dark:bg-neutral-800/70"
  >
    <summary class="cursor-pointer rounded-sm font-semibold leading-7 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-600 dark:focus-visible:outline-amber-400">
      {t.question}
    </summary>
    <p class="mt-3 max-w-3xl leading-7 text-neutral-700 dark:text-neutral-300">
      {t.answer}
    </p>
  </details>
</section>
