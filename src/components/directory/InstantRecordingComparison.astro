---
import { recordingMediumCopy } from '@copy/recording-medium';
import { localePath, type MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = recordingMediumCopy[locale];
const examples = [
  { id: 'pentax-17', name: 'Pentax 17' },
  { id: 'instax-mini-99', name: 'instax mini 99' },
  { id: 'instax-mini-evo', name: 'instax mini Evo' },
] as const;
---

<section
  aria-labelledby="instant-film-comparison"
  class="mt-8 border-t border-neutral-300 pt-7 dark:border-neutral-700"
>
  <h2
    id="instant-film-comparison"
    tabindex="-1"
    class="scroll-mt-28 text-2xl font-bold"
  >
    {t.title}
  </h2>
  <p class="mt-3 max-w-3xl leading-7 text-neutral-700 dark:text-neutral-300">
    {t.intro}
  </p>
  <div class="mt-5 grid gap-4 lg:grid-cols-3">
    {examples.map(({ id, name }) => (
      <div
        data-recording-example={id}
        class="rounded-xl border border-neutral-300 bg-white p-4 sm:p-5 dark:border-neutral-600 dark:bg-neutral-950"
      >
        <h3 class="text-lg font-bold">{name}</h3>
        <p class="mt-1 text-sm font-semibold text-amber-800 dark:text-amber-300">
          {t.flows[id].kind}
        </p>
        <dl class="mt-3 space-y-3 text-sm leading-6">
          {t.stages.map((stage, index) => (
            <div>
              <dt class="font-semibold">{stage}</dt>
              <dd class="mt-0.5 text-neutral-700 dark:text-neutral-300">
                {t.flows[id].steps[index]}
              </dd>
            </div>
          ))}
        </dl>
        {id === 'pentax-17' && (
          <a
            href={localePath(locale, '/gear/pentax-17/#format-example')}
            class="mt-4 inline-block rounded-sm py-2 text-sm font-semibold text-amber-800 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 dark:text-amber-300 dark:focus-visible:outline-amber-400"
          >
            {t.pentaxLink} →
          </a>
        )}
      </div>
    ))}
  </div>
  <p class="mt-5 max-w-3xl text-sm leading-6 text-neutral-700 dark:text-neutral-300">
    {t.printSize}
  </p>
  <details
    data-recording-self-check
    class="mt-5 rounded-xl border border-neutral-300 bg-neutral-100 p-4 dark:border-neutral-600 dark:bg-neutral-800/70"
  >
    <summary class="cursor-pointer rounded-sm font-semibold leading-7 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-600 dark:focus-visible:outline-amber-400">
      {t.question}
    </summary>
    <p class="mt-3 max-w-3xl leading-7 text-neutral-700 dark:text-neutral-300">
      {t.answer}
    </p>
  </details>
</section>
