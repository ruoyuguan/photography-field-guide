---
import { cameraFormCopy, cameraFormExamples } from '@copy/camera-forms';
import { localePath, type MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = cameraFormCopy[locale];
const maxGrams = Math.max(...cameraFormExamples.map(example => example.grams));
const formatGrams = new Intl.NumberFormat(locale);
---

<section
  aria-labelledby="camera-form-examples"
  data-pagefind-meta={
    t.searchAliases ? 'search_aliases[data-search-aliases]' : undefined
  }
  data-search-aliases={t.searchAliases}
  class="mt-8 border-t border-neutral-300 pt-7 dark:border-neutral-700"
>
  <h2
    id="camera-form-examples"
    tabindex="-1"
    class="scroll-mt-28 text-2xl font-bold"
  >
    {t.title}
  </h2>
  <p class="mt-3 max-w-3xl leading-7 text-neutral-700 dark:text-neutral-300">
    {t.intro}
  </p>
  <div class="mt-5 grid gap-4 lg:grid-cols-3">
    {cameraFormExamples.map(example => {
      const copy = t.examples[example.id];
      const massWidth = (example.grams / maxGrams) * 100;
      return (
        <div
          data-camera-form-example={example.id}
          class="min-w-0 rounded-xl border border-neutral-300 bg-white p-4 dark:border-neutral-600 dark:bg-neutral-950"
        >
          <h3 class="text-lg font-bold leading-6">{copy.title}</h3>
          <p class="mt-2 text-sm font-semibold leading-6 text-amber-800 dark:text-amber-300">
            {example.name}
          </p>
          <dl class="mt-3 space-y-3 text-sm leading-6">
            <div>
              <dt class="font-semibold">{t.weightLabel}</dt>
              <dd class="text-neutral-700 dark:text-neutral-300">
                <span
                  data-camera-form-mass={example.grams}
                  class="tabular-nums"
                >
                  {t.approx} {formatGrams.format(example.grams)} g
                </span>
                <span
                  aria-hidden="true"
                  class="mt-1 block h-2 rounded-full bg-neutral-200 dark:bg-neutral-700"
                >
                  <span
                    data-camera-form-mass-bar
                    class="block h-full rounded-full bg-amber-700 dark:bg-amber-300"
                    style={`width: ${massWidth}%`}
                  ></span>
                </span>
              </dd>
            </div>
            <div>
              <dt class="font-semibold">{t.equivalentLabel}</dt>
              <dd class="text-neutral-700 dark:text-neutral-300">
                {example.equivalentRange}
              </dd>
            </div>
            <div>
              <dt class="font-semibold">{t.setupLabel}</dt>
              <dd class="text-neutral-700 dark:text-neutral-300">
                {copy.setup}
              </dd>
            </div>
            <div>
              <dt class="font-semibold">{t.taskLabel}</dt>
              <dd class="text-neutral-700 dark:text-neutral-300">
                {copy.task}
              </dd>
            </div>
          </dl>
          {example.id === 'x-t5-kit' && (
            <div class="mt-2 flex flex-wrap gap-x-4">
              <a
                href={localePath(locale, '/gear/fujifilm-x-t5/#classification')}
                class="inline-flex min-h-11 items-center rounded-sm font-semibold text-amber-800 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-600 dark:text-amber-300 dark:focus-visible:outline-amber-400"
              >
                {t.bodyLink}
              </a>
              <a
                href={localePath(locale, '/gear/fujifilm-xf16-50/')}
                class="inline-flex min-h-11 items-center rounded-sm font-semibold text-amber-800 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-600 dark:text-amber-300 dark:focus-visible:outline-amber-400"
              >
                {t.lensLink}
              </a>
            </div>
          )}
        </div>
      );
    })}
  </div>
  <p class="mt-4 max-w-3xl text-sm leading-6 text-neutral-700 dark:text-neutral-300">
    {t.weightNote}
  </p>
  <section aria-labelledby="camera-form-check" class="mt-8 max-w-3xl">
    <h3
      id="camera-form-check"
      tabindex="-1"
      class="scroll-mt-28 text-xl font-bold"
    >
      {t.practiceTitle}
    </h3>
    <p class="mt-3 leading-7 text-neutral-700 dark:text-neutral-300">
      {t.practiceIntro}
    </p>
    <div class="mt-4 grid gap-4">
      {t.cases.map(scenario => (
        <article
          aria-labelledby={`camera-form-case-${scenario.id}`}
          data-camera-form-case={scenario.id}
          class="min-w-0 rounded-xl border border-neutral-300 bg-neutral-100 p-3 sm:p-4 dark:border-neutral-600 dark:bg-neutral-800/70"
        >
          <h4
            id={`camera-form-case-${scenario.id}`}
            class="font-semibold leading-7"
          >
            {scenario.prompt}
          </h4>
          <div class="mt-3 space-y-2">
            {scenario.choices.map(choice => (
              <details
                name={`camera-form-check-${scenario.id}`}
                data-camera-form-choice={choice.id}
                class="rounded-lg border border-neutral-300 bg-white open:border-amber-600 dark:border-neutral-600 dark:bg-neutral-950 dark:open:border-amber-400"
              >
                <summary class="min-h-11 cursor-pointer rounded-lg px-3 py-2 font-medium leading-7 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 dark:focus-visible:outline-amber-400">
                  {choice.label}
                </summary>
                <p class="border-t border-neutral-200 px-3 py-2 leading-7 text-neutral-700 dark:border-neutral-700 dark:text-neutral-300">
                  <strong>{choice.result}</strong> {choice.feedback}
                </p>
              </details>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</section>
