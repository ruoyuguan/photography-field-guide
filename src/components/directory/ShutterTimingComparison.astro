---
import { shutterTimingCopy } from '@copy/shutter-timing';
import type { MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = shutterTimingCopy[locale];
const rowCenters = [16, 48, 80];
const rollingStarts = [65, 107, 149];
const panels = [
  { id: 'rolling-long', starts: rollingStarts, duration: 60 },
  { id: 'rolling-short', starts: rollingStarts, duration: 20 },
  { id: 'global-short', starts: [65, 65, 65], duration: 20 },
] as const;
---

<section
  aria-labelledby="shutter-timing"
  class="mt-8 border-t border-neutral-300 pt-7 dark:border-neutral-700"
>
  <h2 id="shutter-timing" tabindex="-1" class="scroll-mt-28 text-2xl font-bold">
    {t.title}
  </h2>
  <p class="mt-3 max-w-3xl leading-7 text-neutral-700 dark:text-neutral-300">
    {t.intro}
  </p>
  <div class="mt-5 grid gap-4 lg:grid-cols-3">
    {panels.map(({ id, starts, duration }) => (
      <figure
        data-shutter-panel={id}
        class="min-w-0 rounded-xl border border-neutral-300 bg-white p-3 sm:p-4 dark:border-neutral-600 dark:bg-neutral-950"
      >
        <h3 class="font-bold leading-6 lg:min-h-12">{t.panels[id].title}</h3>
        <div class="mt-3 grid grid-cols-[auto_minmax(0,1fr)] gap-x-2">
          <div
            aria-hidden="true"
            class="grid h-24 grid-rows-3 items-center text-xs text-neutral-700 dark:text-neutral-300"
          >
            {t.rowLabels.map(label => (
              <span>{label}</span>
            ))}
          </div>
          <svg
            class="h-24 w-full"
            viewBox="50 0 174 96"
            preserveAspectRatio="none"
            role="img"
            aria-label={t.panels[id].alt}
          >
            <g
              class="stroke-neutral-300 dark:stroke-neutral-700"
              stroke-dasharray="3 4"
            >
              {rollingStarts.map(x => (
                <line
                  x1={x}
                  y1="0"
                  x2={x}
                  y2="91"
                  vector-effect="non-scaling-stroke"
                />
              ))}
            </g>
            <g class="stroke-neutral-400 dark:stroke-neutral-600">
              {rowCenters.map(y => (
                <line
                  x1="51"
                  y1={y}
                  x2="222"
                  y2={y}
                  vector-effect="non-scaling-stroke"
                />
              ))}
            </g>
            {starts.map((x, index) => (
              <rect
                data-shutter-exposure
                x={x}
                y={rowCenters[index] - 6}
                width={duration}
                height="12"
                rx="2"
                class="fill-amber-700 dark:fill-amber-300"
              />
            ))}
            <path
              d="M51 92h169m-5-3 5 3-5 3"
              fill="none"
              vector-effect="non-scaling-stroke"
              class="stroke-neutral-600 dark:stroke-neutral-300"
            />
          </svg>
          <span class="col-start-2 justify-self-end text-xs text-neutral-700 dark:text-neutral-300">
            {t.timeAxis}
          </span>
        </div>
        <figcaption class="mt-3 text-sm leading-6 text-neutral-700 dark:text-neutral-300">
          {t.panels[id].caption}
        </figcaption>
      </figure>
    ))}
  </div>
  <p class="mt-4 max-w-3xl text-sm leading-6 text-neutral-700 dark:text-neutral-300">
    {t.note}
  </p>
  <details
    data-shutter-self-check
    class="mt-5 rounded-xl border border-neutral-300 bg-neutral-100 p-4 dark:border-neutral-600 dark:bg-neutral-800/70"
  >
    <summary class="cursor-pointer rounded-sm font-semibold leading-7 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-600 dark:focus-visible:outline-amber-400">
      {t.question}
    </summary>
    <p class="mt-3 max-w-3xl leading-7 text-neutral-700 dark:text-neutral-300">
      {t.answer}
    </p>
  </details>
</section>
