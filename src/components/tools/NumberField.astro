---
interface Props {
  idPrefix: string;
  name: string;
  label: string;
  value: string;
  min: number;
  max: number;
  step?: number | string;
  rangeValue: number;
  rangeMin: number;
  rangeMax: number;
  rangeStep?: number | string;
  scale?: 'linear' | 'log2';
  unit?: string;
  prefix?: string;
  format?: 'decimal' | 'shutter';
  fraction?: boolean;
  customPreset?: string;
}

const {
  idPrefix,
  name,
  label,
  value,
  min,
  max,
  step = 'any',
  rangeValue,
  rangeMin,
  rangeMax,
  rangeStep = 'any',
  scale = 'linear',
  unit,
  prefix,
  format = 'decimal',
  fraction = false,
  customPreset,
} = Astro.props;
const id = `${idPrefix}-${name.replaceAll('.', '-')}`;
const errorId = `${id}-error`;
---

<div class="min-w-0">
  <label
    for={id}
    class="block text-sm font-semibold text-neutral-800 dark:text-neutral-200"
  >
    {label}
  </label>
  <div class="mt-2 flex items-center rounded-lg border border-neutral-300 bg-white focus-within:border-amber-500 focus-within:ring-2 focus-within:ring-amber-400/30 dark:border-neutral-600 dark:bg-neutral-900">
    {prefix && (
      <span class="ps-3 text-sm text-neutral-500 dark:text-neutral-400">
        {prefix}
      </span>
    )}
    <input
      id={id}
      name={id}
      type={fraction ? 'text' : 'number'}
      inputmode="decimal"
      value={value}
      min={fraction ? undefined : min}
      max={fraction ? undefined : max}
      step={fraction ? undefined : step}
      data-field={name}
      data-format={format}
      data-fraction={fraction ? 'true' : undefined}
      data-custom-preset={customPreset}
      aria-describedby={errorId}
      class="min-w-0 flex-1 border-0 bg-transparent px-3 py-2.5 text-base text-neutral-900 outline-none focus:ring-0 dark:text-neutral-100"
    />
    {unit && (
      <span class="pe-3 text-sm text-neutral-500 dark:text-neutral-400">
        {unit}
      </span>
    )}
  </div>
  <input
    type="range"
    value={rangeValue}
    min={rangeMin}
    max={rangeMax}
    step={rangeStep}
    data-range-for={name}
    data-scale={scale}
    aria-label={label}
    class="mt-3 h-2 w-full accent-amber-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-500"
  />
  <p class="mt-1 flex justify-between gap-2 text-xs text-neutral-500 dark:text-neutral-400">
    <span>{min}</span>
    <span>
      {max}
      {unit ? ` ${unit}` : ''}
    </span>
  </p>
  <p
    id={errorId}
    data-error-for={name}
    hidden
    class="mt-2 text-sm text-red-700 dark:text-red-300"
  ></p>
</div>
