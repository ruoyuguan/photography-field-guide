---
import { learningStartsCopy } from '@copy/learning-starts';
import { localePath, type MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
  context?: 'home' | 'learn';
}

const { locale, context = 'home' } = Astro.props;
const copy = learningStartsCopy[locale];
const headingId = `learning-starts-${context}-${locale}`;
---

<section
  class="learning-starts not-content"
  data-learning-starts
  data-learning-context={context}
  aria-labelledby={headingId}
>
  <h2 id={headingId}>{copy.heading}</h2>
  <p class="learning-starts__intro">{copy.intro}</p>
  <div class="learning-starts__cards">
    {copy.cards.map(card => (
      <article class="learning-starts__card" data-start-route={card.id}>
        <h3>{card.title}</h3>
        <p>{card.description}</p>
        <a href={localePath(locale, card.path)} data-start-link>
          {card.linkLabel}
          <span aria-hidden="true"> →</span>
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .learning-starts {
    --starts-text: var(--sl-color-text, #262626);
    --starts-muted: var(--sl-color-gray-2, #525252);
    --starts-surface: var(--sl-color-gray-7, #fafafa);
    --starts-border: var(--sl-color-gray-5, #d4d4d4);
    --starts-link: var(--sl-color-text-accent, #92400e);
    color: var(--starts-text);
    min-width: 0;
  }

  :global(html.dark) .learning-starts,
  :global(html[data-theme='dark']) .learning-starts {
    --starts-text: var(--sl-color-text, #f5f5f5);
    --starts-muted: var(--sl-color-gray-2, #d4d4d4);
    --starts-surface: var(--sl-color-gray-6, #171717);
    --starts-border: var(--sl-color-gray-5, #525252);
    --starts-link: var(--sl-color-text-accent, #fcd34d);
  }

  .learning-starts[data-learning-context='learn'] {
    margin-block: 1.5rem 2rem;
  }

  .learning-starts h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--starts-text);
  }

  .learning-starts__intro {
    margin: 0.75rem 0 0;
    color: var(--starts-muted);
    line-height: 1.65;
  }

  .learning-starts__cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .learning-starts__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid var(--starts-border);
    border-radius: 1rem;
    background: var(--starts-surface);
    overflow-wrap: anywhere;
  }

  .learning-starts__card h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--starts-text);
  }

  .learning-starts__card p {
    flex: 1;
    margin: 0.75rem 0;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--starts-muted);
  }

  .learning-starts__card a {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.3rem;
    min-height: 2.75rem;
    border-radius: 0.25rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--starts-link);
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
  }

  .learning-starts__card a:hover {
    text-decoration-thickness: 0.15em;
  }

  .learning-starts__card a:focus-visible {
    outline: 3px solid var(--starts-link);
    outline-offset: 4px;
  }
</style>
