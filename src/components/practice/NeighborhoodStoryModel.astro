---
import type { PracticeLocale } from '@data/practice';

interface Props {
  locale: PracticeLocale;
  prefix: string;
}
const { locale, prefix } = Astro.props;
const copy = {
  en: {
    environment: 'Environment',
    environmentText:
      'The facade, pavement, and bicycle establish a small cafe corner.',
    subject: 'Subject',
    subjectText:
      'The bicycle becomes the particular subject; the cafe remains recognizable.',
    detail: 'Detail',
    detailText:
      'The worn bell and amber stripe offer a close clue connected to the same place.',
    bicycle: 'Bicycle',
    cafe: 'Cafe',
    bell: 'Worn bell',
  },
  'zh-cn': {
    environment: '环境',
    environmentText: '门面、人行道与自行车交代一个小店街角。',
    subject: '主体',
    subjectText: '自行车成为具体主体，小店仍然可以辨认。',
    detail: '细节',
    detailText: '磨损的车铃与琥珀色条纹，为同一地点提供近距离线索。',
    bicycle: '自行车',
    cafe: '小店',
    bell: '磨损车铃',
  },
}[locale];
---

<div data-story-model class="mt-4 grid gap-4 md:grid-cols-3">
  <figure
    data-story-frame="environment"
    class="rounded-xl border border-neutral-300 bg-neutral-50 p-3 dark:border-neutral-600 dark:bg-neutral-950/60"
  >
    <figcaption class="text-sm font-bold text-neutral-900 dark:text-neutral-100">
      A · {copy.environment}
    </figcaption>
    <svg
      viewBox="0 0 320 230"
      role="img"
      aria-labelledby={`${prefix}-environment-title ${prefix}-environment-desc`}
      class="mt-2 h-auto w-full"
    >
      <title id={`${prefix}-environment-title`}>{copy.environment}</title>
      <desc id={`${prefix}-environment-desc`}>{copy.environmentText}</desc>
      <rect width="320" height="230" rx="8" fill="#e7e5e4" />
      <rect x="28" y="32" width="264" height="140" fill="#d6d3d1" />
      <rect x="42" y="62" width="236" height="24" fill="#d97706" />
      <path d="M42 86h236l-13 16H55Z" fill="#fbbf24" />
      <rect x="52" y="105" width="80" height="67" fill="#44403c" />
      <rect x="149" y="105" width="111" height="67" fill="#f5f5f4" />
      <text x="160" y="140" font-size="15" fill="#44403c">
        {copy.cafe}
      </text>
      <path d="M0 190h320" stroke="#78716c" stroke-width="3" />
      <g fill="none" stroke="#44403c" stroke-width="3">
        <circle cx="176" cy="181" r="22" />
        <circle cx="240" cy="181" r="22" />
        <path d="M176 181l24-38 20 38h-44l31-25 33 25m-40-38h-15m35 0-5-13h17" />
      </g>
      <text x="28" y="215" font-size="12" fill="#44403c">
        {locale === 'en' ? 'Cafe · street · bicycle' : '小店 · 街道 · 自行车'}
      </text>
    </svg>
    <p class="mt-2 text-xs leading-5 text-neutral-600 dark:text-neutral-400">
      {copy.environmentText}
    </p>
  </figure>

  <figure
    data-story-frame="subject"
    class="rounded-xl border border-neutral-300 bg-neutral-50 p-3 dark:border-neutral-600 dark:bg-neutral-950/60"
  >
    <figcaption class="text-sm font-bold text-neutral-900 dark:text-neutral-100">
      B · {copy.subject}
    </figcaption>
    <svg
      viewBox="0 0 320 230"
      role="img"
      aria-labelledby={`${prefix}-subject-title ${prefix}-subject-desc`}
      class="mt-2 h-auto w-full"
    >
      <title id={`${prefix}-subject-title`}>{copy.subject}</title>
      <desc id={`${prefix}-subject-desc`}>{copy.subjectText}</desc>
      <rect width="320" height="230" rx="8" fill="#e7e5e4" />
      <rect x="18" y="32" width="284" height="26" fill="#d97706" />
      <path d="M18 58h284l-12 15H30Z" fill="#fbbf24" />
      <path d="M0 197h320" stroke="#78716c" stroke-width="3" />
      <g fill="none" stroke="#44403c" stroke-width="4">
        <circle cx="90" cy="157" r="48" />
        <circle cx="229" cy="157" r="48" />
        <path d="M90 157l51-83 43 83H90l67-54 72 54m-88-83h-32m75 0-11-29h38" />
      </g>
      <circle cx="184" cy="54" r="9" fill="#a8a29e" stroke="#44403c" />
      <path d="m178 52 6 3 5-4" fill="none" stroke="#f5f5f4" stroke-width="2" />
      <text x="22" y="217" font-size="13" fill="#44403c">
        {copy.bicycle}
      </text>
    </svg>
    <p class="mt-2 text-xs leading-5 text-neutral-600 dark:text-neutral-400">
      {copy.subjectText}
    </p>
  </figure>

  <figure
    data-story-frame="detail"
    class="rounded-xl border border-neutral-300 bg-neutral-50 p-3 dark:border-neutral-600 dark:bg-neutral-950/60"
  >
    <figcaption class="text-sm font-bold text-neutral-900 dark:text-neutral-100">
      C · {copy.detail}
    </figcaption>
    <svg
      viewBox="0 0 320 230"
      role="img"
      aria-labelledby={`${prefix}-detail-title ${prefix}-detail-desc`}
      class="mt-2 h-auto w-full"
    >
      <title id={`${prefix}-detail-title`}>{copy.detail}</title>
      <desc id={`${prefix}-detail-desc`}>{copy.detailText}</desc>
      <rect width="320" height="230" rx="8" fill="#d6d3d1" />
      <path d="M-20 186 340 70" stroke="#d97706" stroke-width="34" />
      <path d="M-20 174 340 58" stroke="#fbbf24" stroke-width="6" />
      <circle
        cx="163"
        cy="99"
        r="59"
        fill="#a8a29e"
        stroke="#44403c"
        stroke-width="4"
      />
      <path
        d="M113 93a52 52 0 0 1 94-23"
        fill="none"
        stroke="#e7e5e4"
        stroke-width="6"
      />
      <path
        d="m133 76 18 9m-10 16 24 8m-10 17 13 5m24-67-7 17m26-4-10 13"
        stroke="#57534e"
        stroke-width="3"
      />
      <circle cx="163" cy="99" r="10" fill="#78716c" />
      <text x="22" y="216" font-size="13" fill="#292524">
        {copy.bell}
      </text>
    </svg>
    <p class="mt-2 text-xs leading-5 text-neutral-600 dark:text-neutral-400">
      {copy.detailText}
    </p>
  </figure>
</div>
