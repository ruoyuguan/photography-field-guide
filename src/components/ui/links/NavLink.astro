---
interface Props {
  url: string;
  name: string;
}
const { url, name } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '');
const target = url.replace(/\/$/, '');
const exact = current === target;
const active = exact || (target !== '' && current.startsWith(`${target}/`));
---

<a
  href={url}
  data-astro-prefetch
  aria-current={exact ? 'page' : active ? 'location' : undefined}
  class:list={[
    'rounded-lg px-1 py-2 text-sm font-medium outline-offset-4 hover:text-amber-700 focus-visible:outline-2 focus-visible:outline-amber-600 dark:hover:text-amber-300',
    active
      ? 'text-amber-800 dark:text-amber-300'
      : 'text-neutral-700 dark:text-neutral-200',
  ]}
>
  {name}
</a>
