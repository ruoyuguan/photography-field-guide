---
import { localePath, type MarketingLocale } from '@utils/locale';

const starlightLocale = Astro.locals.starlightRoute.locale;
const locale: MarketingLocale = starlightLocale === 'zh-cn' ? 'zh-cn' : 'en';
const isChinese = locale === 'zh-cn';
const main = localePath(locale);
const docs = localePath(locale, '/learn/');
---

<span class="site-title">
  <a class="main-logo" href={main} aria-label="Photography Field Guide">
    Photography <strong>Field Guide</strong>
  </a>
  <a
    class="docs-logo"
    href={docs}
    aria-label={isChinese ? '摄影学习指南' : 'Photography guides'}
  >
    {isChinese ? '摄影指南' : 'GUIDES'}
  </a>
</span>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-right: 1rem;
    white-space: nowrap;
  }

  .site-title a {
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .main-logo {
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .main-logo strong {
    color: var(--sl-color-accent-high);
  }

  .docs-logo {
    border-left: 1px solid var(--sl-color-gray-5);
    padding-left: 0.8rem;
    color: var(--sl-color-gray-2) !important;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .site-title a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 4px;
  }
</style>
