---
import { LOCALE_INFO, MARKETING_LOCALES, alternatePaths } from '@utils/locale';
const { locale, copy: t } = Astro.locals;
const alternates = alternatePaths(Astro.url.pathname);
---

<details class="language-picker relative">
  <summary
    class="cursor-pointer rounded-lg px-2 py-2 text-sm text-neutral-700 outline-offset-4 focus-visible:outline-2 dark:text-neutral-200"
    aria-label={t.layout.changeLanguage}
  >
    {LOCALE_INFO[locale].label}
  </summary>
  <div class="absolute right-0 z-60 mt-2 min-w-32 rounded-xl border border-neutral-300 bg-neutral-50 p-2 shadow-lg dark:border-neutral-600 dark:bg-neutral-900">
    {MARKETING_LOCALES.map(item => (
      <a
        class="block rounded-lg px-3 py-2 text-sm text-neutral-800 hover:bg-amber-100 focus-visible:outline-2 dark:text-neutral-100 dark:hover:bg-neutral-700"
        href={alternates[item]}
        hreflang={LOCALE_INFO[item].lang}
        lang={LOCALE_INFO[item].lang}
        aria-current={item === locale ? 'page' : undefined}
      >
        {LOCALE_INFO[item].label}
      </a>
    ))}
  </div>
</details>
