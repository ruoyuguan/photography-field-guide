---
const { class: className = '', ...attrs } = Astro.props;
---

<span class={`brand-logo ${className}`} {...attrs}>
  <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <rect x="4" y="4" width="40" height="40" rx="13" class="fill-amber-400" />
    <circle
      cx="24"
      cy="24"
      r="12"
      stroke="currentColor"
      stroke-width="2.5"
      class="text-neutral-900"
    />
    <path
      d="M24 12v12l10 6M36 24H24l-5-10M24 36V24l-10-6M12 24h12l5 10"
      stroke="currentColor"
      stroke-width="2"
      class="text-neutral-900"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle cx="24" cy="24" r="3" class="fill-neutral-900" />
  </svg>
  <span class="brand-wordmark">
    <span>Photography</span>
    <span class="text-amber-500 dark:text-amber-400">Field Guide</span>
  </span>
</span>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: #262626;
  }

  .brand-logo svg {
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
  }

  .brand-wordmark {
    display: flex;
    flex-direction: column;
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  :global(.dark) .brand-logo {
    color: #f5f5f5;
  }
</style>
